# Credenciales del bot de Casiopea — PLANTILLA
#
# El bot lo creas TU, con TU cuenta, en:
#     https://wiki.ead.pucv.cl/Special:BotPasswords
#
# Un bot password es una contrasena secundaria atada a tu usuario, con los
# permisos que marques y revocable en un clic. Consecuencia: todo lo que el
# agente escriba en la wiki queda firmado con TU nombre en el historial
# publico. Marca solo los grants que necesites y lee los diffs antes de
# confirmar. La responsabilidad es tuya, no del modelo.
#
# 1. Copia este archivo a `credentials` (sin extension).
# 2. Reemplaza los valores demo por los reales.
# 3. El archivo `credentials` esta en .gitignore y NUNCA debe commitearse.
# 4. Da permisos restrictivos:
#       chmod 600 credentials
# 5. Comprueba que quedo bien:
#       python3 casiopea-wiki/skills/casiopea/scripts/casiopea.py doctor

# Formato Usuario@NombreBot. El @ y el nombre del bot son obligatorios:
# poner solo el usuario produce un WrongPass que parece otra cosa.
CASIOPEA_BOT_USER=TuUsuario@NombreDelBot

# Contrasena larga que genera Special:BotPasswords. No es tu contrasena
# normal, y se muestra una sola vez.
CASIOPEA_BOT_PASS=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Equivalen a CASIOPEA_PROD_BOT_USER / CASIOPEA_PROD_BOT_PASS, que tambien
# se aceptan. Con esto basta: el skill trabaja contra produccion.

# OPCIONAL, solo si tienes un espejo de desarrollo en http://casiopea.local
# (casi nadie lo tiene). El bot se crea en el espejo, no en produccion: el de
# produccion no sirve ahi. Sin estas dos lineas, el espejo no existe para el
# skill y el servidor MCP ni siquiera ofrece el parametro `wiki`.
# CASIOPEA_LOCAL_BOT_USER=TuUsuario@NombreDelBot
# CASIOPEA_LOCAL_BOT_PASS=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Opcional: a que wiki van las llamadas que no dicen cual (prod o local).
# Por defecto, prod.
# CASIOPEA_DEFAULT_WIKI=local

# Opcional: otra URL para cualquiera de las dos instancias.
# CASIOPEA_API_URL=https://wiki.ead.pucv.cl/api.php
# CASIOPEA_LOCAL_API_URL=http://casiopea.local/api.php

# Opcional: presupuesto de bytes antes de que `page` trunque (50000 por
# defecto). Bajalo si trabajas con un modelo de ventana corta.
# CASIOPEA_MAX_BYTES=50000
